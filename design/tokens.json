  "shadow": {
    "raised": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        },
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "1px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        }
      ]
    },
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        },
        {
          "offsetX": "0px",
          "offsetY": "6px",
          "blur": "16px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        }
      ]
    },
    "floating": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        },
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "32px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-strong}"
        }
      ]
    },
    "sheet": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "-2px",
          "blur": "8px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        },
        {
          "offsetX": "0px",
          "offsetY": "-12px",
          "blur": "40px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-strong}"
        }
      ]
    },
    "glow": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "{color.<mode>.shadow-soft}"
        },
        {
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "32px",
          "spread": "0px",
          "color": "{color.<mode>.glow-accent}"
        }
      ]
    }
  }
