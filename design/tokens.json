{
  "$description": "EyePath v2 design tokens, exported from Figma (Dr Lynch file, collections 'EyePath v2 / Color' and 'EyePath v2 / Size'). Font: Atkinson Hyperlegible Next.",
  "color": {
    "light": {
      "bg-page": {
        "$type": "color",
        "$value": "#f2f5f5",
        "$description": "App background behind cards and tabs."
      },
      "bg-surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Cards, sheets, tab bar, header chip."
      },
      "bg-surface-2": {
        "$type": "color",
        "$value": "#edf1f2",
        "$description": "Inset controls: segment track, chips, icon tiles, inputs."
      },
      "bg-sunken": {
        "$type": "color",
        "$value": "#e6eced",
        "$description": "Reserved: recessed wells (not used in screens yet)."
      },
      "bg-stage": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Live light preview and client stage. Always black; content, not theme."
      },
      "bg-scrim": {
        "$type": "color",
        "$value": "#0f1b1d5c",
        "$description": "Dim layer behind sheets and dialogs."
      },
      "border-default": {
        "$type": "color",
        "$value": "#e2e7e9",
        "$description": "Hairline borders on cards, chips, header chip, tab bar."
      },
      "border-strong": {
        "$type": "color",
        "$value": "#c9d3d6",
        "$description": "Stronger borders: inputs, code tiles, grabber, selected segment."
      },
      "text-primary": {
        "$type": "color",
        "$value": "#0f1b1d",
        "$description": "Main text and icons."
      },
      "text-secondary": {
        "$type": "color",
        "$value": "#5b6a6d",
